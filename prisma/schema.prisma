generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model otp {
  id         String   @id @default(cuid()) @db.VarChar(25)
  mobile     String   @db.VarChar(50)
  code       String   @db.VarChar(6)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  expiresAt  DateTime @default(now()) @db.Timestamp(5)
  user       user     @relation(fields: [mobile], references: [mobile], onDelete: Cascade)

  @@index([mobile], map: "otp_mobile_fkey")
}

model user {
  mobile           String            @id @db.VarChar(14)
  created_at       DateTime          @default(now())
  updated_at       DateTime
  otp              otp[]
  user_calcium     user_calcium[]
  user_information user_information?
}

model user_image {
  id                  String           @id @default(nanoid()) @db.VarChar(21)
  user_information_id String           @unique @db.VarChar(21)
  file_name           String           @db.VarChar(150)
  mime_type           String           @db.VarChar(16)
  ext                 String           @db.VarChar(8)
  file_path           String           @db.VarChar(255)
  created_at          DateTime         @default(now())
  updated_at          DateTime
  user_information    user_information @relation(fields: [user_information_id], references: [id], onDelete: Cascade)
}

model user_information {
  id         String                  @id @default(nanoid()) @db.VarChar(21)
  userId     String                  @unique @db.VarChar(21)
  full_name  String                  @db.VarChar(100)
  age        user_information_age
  gender     user_information_gender
  district   String                  @db.VarChar(50)
  created_at DateTime                @default(now())
  updated_at DateTime                @updatedAt
  user_image user_image?
  user       user                    @relation(fields: [userId], references: [mobile], onDelete: Cascade)
}

model admin {
  id         String      @id @default(nanoid()) @db.VarChar(21)
  full_name  String      @db.VarChar(50)
  username   String      @unique(map: "username") @db.VarChar(25)
  password   String      @db.VarChar(100)
  created_at DateTime?   @default(now()) @db.Timestamp(0)
  role       admin_role? @default(admin)
}

model food {
  id            String          @id @default(nanoid()) @db.VarChar(21)
  en_name       String          @db.VarChar(100)
  bn_name       String          @db.VarChar(100)
  calcium_mg    Float           @db.Float
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  unit          String          @db.VarChar(20)
  image         String?         @db.VarChar(255)
  food_category food_category[]
}

model category {
  id            String          @id @default(nanoid()) @db.VarChar(21)
  name          String          @db.VarChar(255)
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  food_category food_category[]
}

model food_category {
  food_id     String    @db.VarChar(21)
  category_id String    @db.VarChar(21)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  category    category  @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cate_food_cat_fk")
  food        food      @relation(fields: [food_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "food_food_cat_fk")

  @@id([food_id, category_id])
  @@index([category_id], map: "cate_food_cat_fk")
}

model blog {
  id             String    @id @default(nanoid()) @db.VarChar(21)
  en_title       String    @db.VarChar(255)
  bn_title       String    @db.VarChar(255)
  bn_description String    @db.VarChar(255)
  en_description String    @db.VarChar(255)
  bn_details     String    @db.Text
  en_details     String    @db.Text
  image          String?   @db.VarChar(150)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
}

model calcium_required {
  age        calcium_required_age
  gender     calcium_required_gender
  calcium    Int
  created_at DateTime?               @default(now()) @db.Timestamp(0)

  @@id([age, gender])
}

model user_calcium {
  id               String   @id @default(nanoid()) @db.VarChar(21)
  userId           String   @db.VarChar(21)
  calcium_intake   Int
  created_at       DateTime @default(now())
  calcium_required Int
  user             user     @relation(fields: [userId], references: [mobile], onDelete: Cascade, onUpdate: Restrict, map: "user_calcium_ibfk_1")

  @@index([userId], map: "userId")
}

model banner {
  id         String    @id @db.VarChar(21)
  image      String?   @db.VarChar(150)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

enum user_information_age {
  TODDLER
  CHILD
  TEENAGER
  ADULT
  OLD
}

enum user_information_gender {
  MALE
  FEMALE
}

enum admin_role {
  superadmin
  admin
}

enum calcium_required_age {
  TODDLER
  CHILD
  TEENAGER
  ADULT
  OLD
}

enum calcium_required_gender {
  MALE
  FEMALE
}
